---
// src/pages/projektowanie-wnetrz-torun.astro
// Landing-hub pod klaster fraz „projektowanie / projekt wnętrz Toruń" (GSC:
// „projekt wnętrz toruń", „projektanci wnętrz toruń", „aranżacja wnętrz toruń",
// „pracownia architektury wnętrz toruń" — wszystkie na poz. 25-29 bez strony
// celującej w frazę główną). Hub linkuje wewnętrznie cały klaster usługowy.

import BaseLayout from '../layouts/BaseLayout.astro';
import { srcset } from '../lib/img';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
import Contact from '../components/Contact.astro';
import { breadcrumb } from '../lib/schema';

const seoData = {
  title: 'Projektowanie Wnętrz Toruń — Projekty Mieszkań i Domów | Project Design',
  description: 'Projektowanie wnętrz w Toruniu: projekty mieszkań, domów i lokali z wizualizacjami 3D, meble na wymiar i nadzór nad realizacją. Pracownia Project Design — darmowa konsultacja.',
  keywords: 'projektowanie wnętrz Toruń, projekt wnętrz Toruń, projektant wnętrz Toruń, pracownia projektowania wnętrz Toruń, aranżacja wnętrz Toruń, Project Design'
};

const clusterServices = [
  {
    href: '/aranzacje-wnetrz',
    title: 'Aranżacje wnętrz',
    lead: 'Mieszkania i domy',
    description: 'Projekty kawalerek, mieszkań rodzinnych, apartamentów i domów jednorodzinnych — od układu funkcjonalnego po dobór materiałów i oświetlenia.',
    linkLabel: 'Zobacz aranżacje wnętrz',
  },
  {
    href: '/projektowanie-mebli',
    title: 'Meble na wymiar',
    lead: 'Projekt + wykonanie',
    description: 'Kuchnie, szafy, łazienki i zabudowy projektowane pod konkretne wnętrze i realizowane przez współpracujących stolarzy.',
    linkLabel: 'Zobacz projektowanie mebli',
  },
  {
    href: '/studio-projektowania-wnetrz',
    title: 'Studio projektowe',
    lead: 'Pracownia i proces',
    description: 'Jak pracuje nasza pracownia: etapy projektu, wizualizacje 3D, dokumentacja techniczna i nadzór autorski nad realizacją.',
    linkLabel: 'Poznaj studio',
  },
  {
    href: '/architekci-wnetrz',
    title: 'Architekci wnętrz',
    lead: 'Zespół',
    description: 'Ludzie, którzy poprowadzą Twój projekt — doświadczenie, podejście i realizacje naszych projektantów.',
    linkLabel: 'Poznaj zespół',
  },
];

const steps = [
  { nr: '01', title: 'Konsultacja', description: 'Rozmawiamy o potrzebach, budżecie i terminach. Pierwsza konsultacja jest darmowa.' },
  { nr: '02', title: 'Koncepcja i wizualizacje 3D', description: 'Układ funkcjonalny i wizualizacje, które pokazują wnętrze zanim powstanie.' },
  { nr: '03', title: 'Projekt wykonawczy', description: 'Dokumentacja, dobór materiałów i mebli — wszystko, czego potrzebuje ekipa.' },
  { nr: '04', title: 'Realizacja', description: 'Wsparcie w trakcie prac, meble na wymiar i dopięcie detali do dnia wprowadzenia.' },
];

const faqItems = [
  {
    question: 'Ile kosztuje projektowanie wnętrz w Toruniu?',
    answer: 'Projekty aranżacji zaczynają się od 3000 zł dla kawalerek i małych mieszkań, od 5000 zł dla mieszkań 2-3 pokojowych i od 8000 zł dla dużych apartamentów. Ostateczna wycena zależy od metrażu i zakresu — przygotowujemy ją po darmowej konsultacji.',
  },
  {
    question: 'Co obejmuje projekt wnętrza?',
    answer: 'Układ funkcjonalny, wizualizacje 3D, dobór materiałów i oświetlenia oraz dokumentację dla wykonawców. W ramach współpracy projektujemy też meble na wymiar i możemy nadzorować realizację.',
  },
  {
    question: 'Czy projektujecie tylko w Toruniu?',
    answer: 'Pracownia działa w Toruniu i tu realizujemy większość projektów — mieszkań, domów i lokali. Podejmujemy się też projektów w okolicznych miejscowościach; przy pracy na wizualizacjach i dokumentacji odległość ma coraz mniejsze znaczenie.',
  },
  {
    question: 'Od czego zacząć współpracę z projektantem wnętrz?',
    answer: 'Od darmowej konsultacji — wystarczy rzut mieszkania lub domu i krótka rozmowa o oczekiwaniach. Na tej podstawie przedstawiamy zakres, harmonogram i wycenę projektu.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const breadcrumbSchema = breadcrumb('Projektowanie wnętrz Toruń', '/projektowanie-wnetrz-torun/');

const heroImage = 'https://media.meblesystem.pl/shared/adobe-portfolio/044db97a-3efa-4787-adb0-21e9c2b6a1a3_rw_3840.webp';
const heroSizes = '100vw';
---

<BaseLayout
  {...seoData}
  schemas={[breadcrumbSchema, faqSchema]}
  preloadImage={heroImage}
  preloadImageSrcset={srcset(heroImage)}
  preloadImageSizes={heroSizes}
>
  <!-- Hero -->
  <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={heroImage}
        srcset={srcset(heroImage)}
        sizes={heroSizes}
        fetchpriority="high"
        loading="eager"
        decoding="async"
        alt="Projektowanie wnętrz w Toruniu — wnętrze zaprojektowane przez Project Design"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900/80 via-slate-900/60 to-slate-900/80"></div>
    </div>

    <div class="container mx-auto px-4 lg:px-8 relative z-10 text-center">
      <h1 class="font-display text-5xl lg:text-7xl font-bold text-white mb-6 animate-fade-in">
        Projektowanie <span class="text-amber-500">wnętrz</span> Toruń
      </h1>
      <p class="text-xl text-white/90 mb-8 max-w-3xl mx-auto leading-relaxed">
        Pracownia projektowania wnętrz z Torunia. Projektujemy mieszkania, domy i lokale —
        z wizualizacjami 3D, meblami na wymiar i wsparciem aż do końca realizacji.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a href="#kontakt" class="bg-amber-500 text-white px-8 py-4 rounded-full font-medium text-lg hover:bg-amber-600 transition-all hover:shadow-xl inline-block">
          Darmowa konsultacja
        </a>
        <a href="/realizacje" class="border-2 border-white text-white px-8 py-4 rounded-full font-medium text-lg hover:bg-white hover:text-slate-900 transition-all inline-block">
          Zobacz realizacje
        </a>
      </div>
    </div>
  </section>

  <!-- Zakres usług (hub klastra) -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h2 class="font-display text-4xl lg:text-5xl font-bold text-slate-900 mb-6">
          Czym zajmuje się nasza <span class="text-amber-500">pracownia</span>
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed">
          Projektowanie wnętrz to u nas cały proces — od pierwszego rzutu mieszkania po
          ostatnią zamontowaną szafkę. Wybierz obszar, który Cię interesuje.
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {clusterServices.map((s) => (
          <a href={s.href} class="group block bg-gradient-to-br from-slate-50 to-white border border-slate-200 rounded-2xl p-8 hover:shadow-xl hover:border-amber-500/40 transition-all">
            <p class="text-sm font-medium text-amber-500 uppercase tracking-wide">{s.lead}</p>
            <h3 class="font-display text-2xl font-bold text-slate-900 mt-2">{s.title}</h3>
            <p class="text-slate-600 leading-relaxed mt-3">{s.description}</p>
            <span class="inline-block mt-5 font-medium text-amber-500 group-hover:underline">{s.linkLabel} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Proces -->
  <section class="py-20 bg-gradient-to-br from-slate-50 to-white">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h2 class="font-display text-4xl lg:text-5xl font-bold text-slate-900 mb-6">
          Jak wygląda <span class="text-amber-500">projekt wnętrza</span> krok po kroku
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        {steps.map((step) => (
          <div class="bg-white border border-slate-200 rounded-2xl p-6">
            <div class="text-3xl font-bold text-amber-500 font-display">{step.nr}</div>
            <h3 class="font-display text-lg font-bold text-slate-900 mt-3">{step.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed mt-2">{step.description}</p>
          </div>
        ))}
      </div>
      <p class="text-center mt-10 text-slate-600">
        Cały proces szczegółowo opisaliśmy na stronie
        <a href="/studio-projektowania-wnetrz" class="text-amber-500 font-medium hover:underline">naszego studia projektowego</a>.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h2 class="font-display text-4xl lg:text-5xl font-bold text-slate-900 mb-6">
          Najczęstsze <span class="text-amber-500">pytania</span>
        </h2>
      </div>
      <div class="max-w-3xl mx-auto space-y-4">
        {faqItems.map((item) => (
          <div class="bg-gradient-to-br from-slate-50 to-white border border-slate-200 rounded-2xl p-6 lg:p-8">
            <h3 class="font-display text-lg font-bold text-slate-900">{item.question}</h3>
            <p class="text-slate-600 leading-relaxed mt-3">{item.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Testimonials />
  <CTA />
  <Contact />
</BaseLayout>
