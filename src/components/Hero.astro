---
// src/components/Hero.astro
---

<section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-slate-50 to-amber-50">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23000000' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;);"></div>
  </div>

  <div class="container mx-auto px-4 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div class="animate-fade-in">
        <h1 class="font-display text-5xl lg:text-7xl font-bold text-slate-900 mb-6 leading-tight">
          Projektowanie<br/>
          <span class="text-amber-500">wnętrz</span> Toruń
        </h1>
        <p class="text-xl text-slate-600 mb-8 leading-relaxed">
          Projektujemy z pasją wyjątkowe przestrzenie w Toruniu, które łączą funkcjonalność z estetyką. Od koncepcji po realizację - zamieniamy Twoje marzenia w rzeczywistość.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#kontakt" class="bg-amber-500 text-white px-8 py-4 rounded-full font-medium text-lg hover:bg-amber-600 transition-all hover:shadow-xl transform hover:scale-105 text-center">
            Darmowa wycena
          </a>
          <a href="#portfolio" class="border-2 border-slate-900 text-slate-900 px-8 py-4 rounded-full font-medium text-lg hover:bg-slate-900 hover:text-white transition-all text-center">
            Zobacz realizacje
          </a>
        </div>
        
        <!-- Trust badges -->
        <div class="flex flex-wrap gap-6 mt-12">
          <div class="flex items-center space-x-2">
            <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="text-sm text-slate-600">Toruń i okolice</span>
          </div>
          <div class="flex items-center space-x-2">
            <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-sm text-slate-600">Szybka realizacja</span>
          </div>
          <div class="flex items-center space-x-2">
            <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-sm text-slate-600">Wysoka jakość</span>
          </div>
        </div>
      </div>

      <!-- Image/Visual -->
      <div class="relative animate-slide-left lg:block">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl">
          <img
            src="https://media.meblesystem.pl/meble-bydgoszcz.pl/realizacje-legacy/Dorota-projektPROJEKT_JASKOLCZA_TORUN_3_opt.webp"
            alt="Nowoczesny salon w projekcie wnętrza mieszkania w Toruniu — realizacja Project Design"
            class="w-full h-full object-cover"
            width="1200"
            height="800"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900/50 to-transparent"></div>
        </div>
        
        <!-- Floating Card 
        <div class="absolute bottom-8 left-8 right-8 bg-white/95 backdrop-blur-sm p-6 rounded-xl shadow-xl">
          
          <h3 class="font-display text-xl font-bold text-slate-900 mb-1">Dom jednorodzinny</h3>
          <p class="text-sm text-slate-600">Rezydencja | Styl nowoczesny | Toruń</p>
        </div>-->
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>
